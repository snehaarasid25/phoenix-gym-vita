---
/**
 * Rotating circular text badge around the phoenix emblem.
 * Text runs on an SVG circle path; the ring spins slowly (paused for reduced motion).
 */
import { site } from '../config/site'

interface Props {
  class?: string
  /** Light ring for dark backgrounds (default) or ink ring for ivory. */
  tone?: 'light' | 'ink'
}

const { class: className, tone = 'light' } = Astro.props
const text = `${site.brandLine} • ${site.brandCall} • `
const id = `badge-path-${Math.random().toString(36).slice(2, 8)}`
---

<div class:list={['pointer-events-none relative grid size-32 place-items-center sm:size-36', className]} aria-hidden="true">
  <svg viewBox="0 0 200 200" class="spin-slow absolute inset-0 size-full">
    <defs>
      <path id={id} d="M100,100 m-78,0 a78,78 0 1,1 156,0 a78,78 0 1,1 -156,0" />
    </defs>
    <circle cx="100" cy="100" r="97" fill="none" stroke="currentColor" stroke-opacity="0.18" class={tone === 'ink' ? 'text-bone' : 'text-gold'} />
    <!-- textLength = circle circumference (2π·78 ≈ 490) so the text closes the ring exactly -->
    <text class:list={['font-mono text-[11.5px] font-semibold uppercase', tone === 'ink' ? 'fill-bone' : 'fill-gold']}>
      <textPath href={`#${id}`} startOffset="0" textLength="488" lengthAdjust="spacing">{text}</textPath>
    </text>
  </svg>
  <span class:list={['grid size-16 place-items-center rounded-full sm:size-[4.5rem]', tone === 'ink' ? 'bg-bone' : 'glass']}>
    <img src="/brand/phoenix-emblem.png" alt="" width="171" height="218" class="h-9 w-auto sm:h-10" />
  </span>
</div>
