---
/**
 * Page shell: <head> SEO, theme bootstrapping, nav/footer, global script.
 * Everything renders to static HTML; only the components marked client:*
 * ship JavaScript (React islands).
 */
import '../styles/index.css'
import { absoluteUrl, ogImage, type PageMeta } from '../config/seo'
import { site } from '../config/site'
import { faqSchema, localBusinessSchema, websiteSchema } from '../utils/structuredData'
import { X } from '@phosphor-icons/react'
import Footer from '../components/Footer.astro'
import InstagramCard from '../components/InstagramCard.astro'
import Navbar from '../components/islands/Navbar'
import MobileActionBar from '../components/islands/MobileActionBar'
import EnquiryModal from '../components/islands/EnquiryModal'
// Preloaded so the first paint already uses the real typefaces (no fallback-font flash)
import bebasWoff2 from '@fontsource/bebas-neue/files/bebas-neue-latin-400-normal.woff2?url'
import manropeWoff2 from '@fontsource-variable/manrope/files/manrope-latin-wght-normal.woff2?url'

interface Props {
  meta: PageMeta
  /** Emit LocalBusiness/WebSite JSON-LD (home page only). */
  structuredData?: boolean
  /** Emit FAQPage JSON-LD (FAQ page only: it must match the questions visible on that page). */
  faqData?: boolean
  /** Responsive srcset of the above-the-fold hero image to preload. */
  preloadImage?: string
  /** Show the branded intro curtain (home page, first visit per session). */
  intro?: boolean
  /** First-visit welcome pop-up (Instagram card). Off on legal pages. */
  welcome?: boolean
}

const { meta, structuredData = false, faqData = false, preloadImage, intro = false, welcome = true } = Astro.props
const canonical = absoluteUrl(meta.path)
const image = absoluteUrl(ogImage)
const pathname = Astro.url.pathname.replace(/\/$/, '') || '/'
const schemas = [...(structuredData ? [localBusinessSchema(), websiteSchema()] : []), ...(faqData ? [faqSchema()] : [])]
const jsonLd = schemas.length ? JSON.stringify(schemas).replace(/</g, '\\u003c') : null
---

<!doctype html>
<html lang="en-IN" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#070605" />
    {intro && <meta name="phoenix-intro" content="1" />}

    <!-- Before first paint: mark JS on, apply saved theme (default: dark; light only if the visitor chose it). Key shared with src/utils/theme.ts -->
    <script is:inline>
      ;(function () {
        var root = document.documentElement
        root.classList.add('js')
        // Mark the page as scrolled straight away (no waiting for the header's JS to load), so the fade
        // behind the floating header is active from the very first scroll (see .nav-scrim in index.css)
        var markScrolled = function () { root.dataset.scrolled = String(window.scrollY > 24) }
        markScrolled()
        window.addEventListener('scroll', markScrolled, { passive: true })
        var introOn = false
        try {
          // Intro at most once every 12h per browser (returning visitors go straight in)
          var seen = Number(localStorage.getItem('phoenix-intro') || 0)
          introOn = !!document.querySelector('meta[name="phoenix-intro"]') && Date.now() - seen > 432e5 && !matchMedia('(prefers-reduced-motion: reduce)').matches
          if (introOn) localStorage.setItem('phoenix-intro', String(Date.now()))
        } catch (e) {}
        root.classList.add(introOn ? 'intro' : 'is-ready')
        var t
        try {
          t = localStorage.getItem('phoenix-theme')
        } catch (e) {}
        var theme = t === 'light' ? 'light' : 'dark'
        root.setAttribute('data-theme', theme)
        if (theme === 'light') document.querySelector('meta[name="theme-color"]').setAttribute('content', '#f7f3ec')
      })()
    </script>

    <title>{meta.title}</title>
    <meta name="description" content={meta.description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={meta.noindex ? 'noindex' : 'index, follow, max-image-preview:large'} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.legalName} />
    <meta property="og:locale" content="en_IN" />
    <meta property="og:title" content={meta.title} />
    <meta property="og:description" content={meta.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={meta.title} />
    <meta name="twitter:description" content={meta.description} />
    <meta name="twitter:image" content={image} />
    <meta name="geo.region" content="IN-MH" />
    <meta name="geo.placename" content={`${site.location.city}, ${site.location.state}`} />

    <link rel="icon" type="image/png" sizes="64x64" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preconnect" href="https://images.unsplash.com" crossorigin />
    <link rel="preload" href={bebasWoff2} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={manropeWoff2} as="font" type="font/woff2" crossorigin />
    {preloadImage && <link rel="preload" as="image" imagesrcset={preloadImage} imagesizes="100vw" fetchpriority="high" />}

    {jsonLd && <script type="application/ld+json" set:html={jsonLd} />}
  </head>
  <body>
    <a
      href="#main"
      class="sr-only z-[100] rounded-full bg-brand-500 px-5 py-3 font-semibold text-ink focus:not-sr-only focus:fixed focus:top-4 focus:left-4"
    >
      Skip to content
    </a>

    <!-- Branded intro curtain: only when <html> has .intro (first visit, motion allowed); lifted by scripts/site.ts -->
    {
      intro && (
        <div id="intro" aria-hidden="true">
          <div class="intro-mark">
            <img src="/brand/phoenix-emblem.png" alt="" width="171" height="218" />
            <span>Phoenix</span>
            <i class="intro-bar" />
          </div>
        </div>
      )
    }


    <!-- Hydrates when the browser is idle: its HTML is already on the page, so nothing waits on it -->
    <Navbar client:idle pathname={pathname} />

    <main id="main">
      <slot />
    </main>

    <Footer pathname={pathname} />

    <MobileActionBar client:idle />

    <!-- First-visit welcome pop-up (scripts/site.ts): the Instagram card, after 30 s on the page, once a week at most -->
    {
      welcome && (
        <dialog
          id="welcome-popup"
          aria-labelledby="welcome-title"
          data-lenis-prevent
          class="site-dialog fixed inset-0 m-0 h-full max-h-none w-full max-w-none overflow-y-auto overscroll-contain bg-transparent p-0 text-bone backdrop:bg-ash-950/80 backdrop:backdrop-blur-sm"
        >
          <div data-backdrop class="flex min-h-full items-center justify-center px-4 py-8">
            <div class="dialog-card w-full max-w-xl">
              <div class="mb-4 flex items-center justify-between gap-4">
                <p id="welcome-title" class="eyebrow flex items-center gap-3 text-brand-300">
                  <span class="h-px w-8 bg-brand-500/60" aria-hidden="true" />
                  Welcome to Phoenix Gym
                </p>
                <form method="dialog">
                  <button aria-label="Close" class="grid size-11 place-items-center rounded-full border border-bone/20 bg-ash-950/60 text-bone backdrop-blur transition-colors hover:border-brand-400 hover:text-brand-300">
                    <X className="size-5" />
                  </button>
                </form>
              </div>
              <InstagramCard reveal={false} stacked />
            </div>
          </div>
        </dialog>
      )
    }

    <!-- "Get early access" / "Enquire" buttons on every page open this pop-up form -->
    <EnquiryModal client:idle />

    <script>
      import '../scripts/site.ts'
    </script>
  </body>
</html>
