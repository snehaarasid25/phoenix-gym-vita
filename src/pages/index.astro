---
/**
 * Home: kept short on purpose. Hook → what's inside → offer → proof → story → trust → act.
 * The full story, contact details/Instagram and FAQ live on their own pages (/about, /contact, /faq).
 */
import BaseLayout from '../layouts/BaseLayout.astro'
import { images } from '../config/images'
import { pages } from '../config/seo'
import { srcSet } from '../utils/image'
import AboutTeaser from '../sections/AboutTeaser.astro'
import Facilities from '../sections/Facilities.astro'
import FinalCta from '../sections/FinalCta.astro'
import Gallery from '../sections/Gallery.astro'
import Hero from '../sections/Hero.astro'
import MantraBand from '../sections/MantraBand.astro'
import Membership from '../sections/Membership.astro'
import Testimonials from '../sections/Testimonials.astro'
import WhyPhoenix from '../sections/WhyPhoenix.astro'
---

<BaseLayout meta={pages.home} structuredData intro preloadImage={srcSet(images.hero.src)}>
  <Hero />
  <MantraBand />
  <Facilities />
  <Membership />
  <Gallery />
  <AboutTeaser />
  <Testimonials />
  <WhyPhoenix />
  <FinalCta />
</BaseLayout>
