---
/**
 * Gym facilities: every zone together with the training it's built for (one section instead of separate
 * "Facilities" and "Programmes" lists). Desktop: hover list + cinematic preview; phones: swipeable cards.
 */
import SectionHeader from '../components/SectionHeader.astro'
import FacilitiesShowcase from '../components/islands/FacilitiesShowcase'
---

<section id="facilities" aria-labelledby="facilities-title" class="panel section-y relative isolate overflow-hidden bg-ash-900">
  <div class="gold-rule absolute inset-x-0 top-0" aria-hidden="true" />
  <div class="glow-orb -top-56 -left-56 size-[46rem]" aria-hidden="true" />
  <div class="glow-orb-soft right-[-12rem] bottom-[-8rem] size-[40rem]" aria-hidden="true" />
  <div class="container-x relative">
    <SectionHeader
      id="facilities-title"
      eyebrow="Gym facilities"
      lines={['Built for', { text: 'every goal.', class: 'text-brand-gradient' }]}
      intro="Heavy iron, HYROX conditioning, steam-bath recovery and a calm yoga and meditation space, all under one roof in Vita. Each zone comes with the training it's built for, so you know exactly where your goal fits."
    />
    <div class="mt-14 sm:mt-20">
      <!-- SSR'd for SEO; becomes interactive once scrolled into view -->
      <FacilitiesShowcase client:visible />
    </div>
  </div>
</section>
