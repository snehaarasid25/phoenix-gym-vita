---
/** Facilities bento grid + conversion tile. */
import { ArrowUpRight, MapPin } from '@phosphor-icons/react'
import { site } from '../config/site'
import { facilities } from '../data/facilities'
import SectionHeader from '../components/SectionHeader.astro'
import { Img } from '../components/ui/Img'
import { PlaceholderBadge } from '../components/ui/PlaceholderBadge'
import type { Facility } from '../types'
import { cn } from '../utils/cn'

const span: Record<NonNullable<Facility['size']>, string> = {
  large: 'lg:col-span-2 lg:row-span-2',
  tall: 'lg:row-span-2',
  wide: 'lg:col-span-2',
  regular: '',
}
---

<section id="facilities" aria-labelledby="facilities-title" class="panel section-y relative bg-ash-900">
  <div class="gold-rule absolute inset-x-0 top-0" aria-hidden="true" />
  <div class="glow-orb -top-56 -left-56 size-[46rem]" aria-hidden="true" />
  <div class="glow-orb-soft right-[-12rem] bottom-[-8rem] size-[40rem]" aria-hidden="true" />
  <div class="container-x relative">
    <SectionHeader
      id="facilities-title"
      index="02"
      eyebrow="Gym facilities"
      lines={['Built for', 'every rep.']}
      intro="Heavy iron, HYROX conditioning, steam-bath recovery and a calm yoga and meditation space, all under one roof in Vita. Every zone is set up for a purpose."
    />

    <div class="mt-14 grid grid-flow-dense gap-4 sm:mt-20 sm:grid-cols-2 lg:auto-rows-[17rem] lg:grid-cols-4 xl:auto-rows-[19rem]">
      {facilities.map((f, i) => (
        <article
          data-theme="dark"
          data-tilt
          class={"reveal spotlight " + cn('group relative isolate aspect-[16/11] overflow-hidden rounded-[1.5rem] bg-ash-800 sm:aspect-auto sm:min-h-[20rem] lg:min-h-0', span[f.size ?? 'regular'])}
          style={`--d:${(i % 4) * 0.08}s`}>
          <Img
            image={f.image}
            sizes={f.size === 'large' || f.size === 'wide' ? '(min-width:1024px) 50vw, 100vw' : '(min-width:1024px) 25vw, (min-width:640px) 50vw, 100vw'}
            width={1080}
            className="absolute inset-0 -z-10 size-full object-cover transition-transform duration-[1.4s] ease-[var(--ease-out-expo)] group-hover:scale-[1.06]"
          />
          <div class="absolute inset-0 -z-10 bg-gradient-to-t from-ash-950 via-ash-950/40 to-ash-950/0 transition-opacity duration-500 group-hover:from-ash-950/95" aria-hidden="true" />
          <div class="absolute inset-0 -z-10 bg-brand-600/0 mix-blend-color transition-colors duration-700 group-hover:bg-brand-600/25" aria-hidden="true" />

          <div class="flex h-full flex-col justify-between p-5 sm:p-7">
            <div class="flex items-start justify-between gap-3">
              <span class="font-mono text-xs text-bone/70">{String(i + 1).padStart(2, '0')}</span>
              {f.status === 'proposed' && <PlaceholderBadge label="To verify" />}
            </div>
            <div>
              <h3 class={cn('font-display leading-none uppercase', f.size === 'large' ? 'text-5xl sm:text-6xl' : 'text-4xl')}>{f.title}</h3>
              <p class="mt-3 max-w-sm text-sm leading-relaxed text-ash-300 transition-all duration-500 lg:max-h-0 lg:translate-y-3 lg:opacity-0 lg:group-hover:max-h-32 lg:group-hover:translate-y-0 lg:group-hover:opacity-100">
                {f.description}
              </p>
            </div>
          </div>
        </article>
      ))}

      <!-- Conversion tile completes the bento grid -->
      <article class="reveal relative flex min-h-[16rem] flex-col justify-between overflow-hidden rounded-[1.5rem] bg-brand-500 p-6 text-ink sm:p-7 lg:min-h-0" style="--d:0.2s">
        <div class="pointer-events-none absolute -top-16 -right-16 size-56 rounded-full bg-gold/50 blur-3xl" aria-hidden="true" />
        <MapPin className="relative size-8" weight="duotone" />
        <div class="relative">
          <h3 class="font-display text-4xl leading-[0.95] uppercase">See it in person.</h3>
          <p class="mt-2 text-sm font-medium text-ink/75">Drop by in {site.location.city} for a walkthrough of the floor.</p>
          <a href="#contact" class="mt-5 inline-flex items-center gap-2 font-mono text-xs font-bold tracking-[0.16em] uppercase underline-offset-4 hover:underline">
            Plan your visit <ArrowUpRight className="size-4" weight="bold" />
          </a>
        </div>
      </article>
    </div>
  </div>
</section>
