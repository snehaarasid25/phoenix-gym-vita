---
/**
 * FAQ: visible answers to real local questions + FAQPage JSON-LD (emitted in
 * BaseLayout from the same data). Native <details> accordion: zero JS,
 * keyboard accessible, and every answer is in the HTML for crawlers.
 */
import { Plus } from '@phosphor-icons/react'
import { site } from '../config/site'
import { faqs } from '../data/faq'
import SectionHeader from '../components/SectionHeader.astro'
---

<section id="faq" aria-labelledby="faq-title" class="section-y relative overflow-hidden bg-ash-900">
  <div class="gold-rule absolute inset-x-0 top-0" aria-hidden="true"></div>
  <div class="glow-orb-soft top-1/4 -left-60 size-[40rem]" aria-hidden="true"></div>
  <div class="container-x relative grid gap-14 lg:grid-cols-12 lg:gap-10">
    <div class="lg:col-span-5">
      <div class="lg:sticky lg:top-28">
        <SectionHeader id="faq-title" index="09" eyebrow="Your questions" lines={['Good to', { text: 'know.', class: 'text-brand-gradient' }]} align="left" />
        <!-- Plain-language local summary (visible, useful to visitors and to search engines) -->
        <div class="reveal mt-8 max-w-md space-y-4 leading-relaxed text-ash-300" style="--d:0.15s">
          <p>
            <strong class="font-semibold text-bone">{site.legalName}</strong> is a premium gym and fitness centre in {`${site.location.city}, ${site.location.district} district, ${site.location.state}`}, established in {site.foundingYear}. Find us on Nevari Road in Bhavaninagar, with strength training, HYROX training, a steam bath, a meditation and yoga area and family batches under one roof.
          </p>
          <p>Can't find your answer? Message us on WhatsApp and the team will get back to you.</p>
        </div>
      </div>
    </div>

    <div class="lg:col-span-7">
      <ul class="border-t hairline">
        {
          faqs.map((f, i) => (
            <li class="reveal border-b hairline" style={`--d:${(i * 0.05).toFixed(2)}s`}>
              <details class="faq group" name="faq">
                <summary class="flex cursor-pointer list-none items-center justify-between gap-6 py-6 text-left text-lg font-semibold tracking-tight text-bone transition-colors hover:text-brand-300 sm:text-xl [&::-webkit-details-marker]:hidden">
                  <h3 class="font-[inherit]">{f.q}</h3>
                  <span class="icon-well size-10 rounded-full transition-transform duration-300 ease-[var(--ease-out-quint)] group-open:rotate-45" aria-hidden="true">
                    <Plus className="size-4" weight="bold" />
                  </span>
                </summary>
                <p class="max-w-2xl pr-14 pb-6 leading-relaxed text-ash-300">{f.a}</p>
              </details>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
