---
/** Gallery: static header + filterable masonry/lightbox island. */
import SectionHeader from '../components/SectionHeader.astro'
import GalleryGrid from '../components/islands/GalleryGrid'
import { PlaceholderBadge } from '../components/ui/PlaceholderBadge'
---

<section id="gallery" aria-labelledby="gallery-title" class="panel section-y relative bg-ash-950">
  <div class="glow-orb -top-48 right-[-14rem] size-[44rem]" aria-hidden="true"></div>
  <div class="container-x relative">
    <SectionHeader id="gallery-title" index="05" eyebrow="Inside the gym" lines={['Inside', 'the fire.']}>
      <Fragment slot="intro">
        The atmosphere, the iron and the work.
        <PlaceholderBadge label="Stock photos — replace with real gym shots" className="mt-4" />
      </Fragment>
    </SectionHeader>
    <GalleryGrid client:visible />
  </div>
</section>
