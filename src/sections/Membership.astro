---
/** Membership plans. Featured plan = same card, gold edge + lift + overhanging badge. */
import { Check, Info } from '@phosphor-icons/react'
import { membershipNote, plans } from '../data/membership'
import SectionHeader from '../components/SectionHeader.astro'
import { Button } from '../components/ui/Button'
import { PlaceholderBadge } from '../components/ui/PlaceholderBadge'
import { cn } from '../utils/cn'
import { formatINR } from '../utils/contact'

const anyUnverified = plans.some((p) => !p.verified)
---

<section id="membership" aria-labelledby="membership-title" class="section-y relative isolate overflow-hidden">
  <div class="bg-dots pointer-events-none absolute inset-0 -z-10" aria-hidden="true"></div>
  <div class="glow-orb -bottom-56 left-1/2 h-[40rem] w-[80rem] -translate-x-1/2" aria-hidden="true" />
  <div class="glow-orb-soft -top-40 -right-40 size-[34rem]" aria-hidden="true" />
  <div class="container-x relative">
    <SectionHeader
      id="membership-title"
      eyebrow="Gym membership"
      lines={['Commit to', { text: 'the climb.', class: 'text-brand-gradient' }]}
      intro="Choose the gym membership that matches your ambition. Longer plans give you the time consistency needs to pay off, and pre-booking for Vita is opening soon."
    />

    <!-- Phones: swipeable row (next card peeks in) + dots; md+: grid -->
    <div
      id="plans-track"
      data-carousel
      class="no-scrollbar -mx-5 mt-12 flex snap-x snap-mandatory scroll-px-5 gap-4 overflow-x-auto px-5 pt-5 pb-2 sm:-mx-8 sm:mt-16 sm:scroll-px-8 sm:px-8 md:mx-0 md:mt-24 md:grid md:snap-none md:grid-cols-2 md:gap-x-4 md:gap-y-10 md:overflow-visible md:px-0 md:pt-0 md:pb-0 xl:grid-cols-4"
    >
      {plans.map((plan, i) => (
        <article
          class={"reveal " + cn(
            /* Featured plan = same object, chosen: same surface, gold edge + lift. Never a different fill. */
            'card-lux group flex w-[84%] shrink-0 snap-start flex-col rounded-[1.75rem] p-7 hover:-translate-y-1.5 sm:w-[70%] sm:p-8 md:w-auto',
            plan.highlight && 'card-featured',
          )}
          style={`--d:${i * 0.08}s`}
        >
          <!-- Decor layer (clipped to the card; the badge above stays free to overhang) -->
          <div class="pointer-events-none absolute inset-0 -z-0 overflow-hidden rounded-[inherit]" aria-hidden="true">
            <span class="plan-aura absolute inset-0"></span>
            <span class="absolute -top-5 -right-3 font-display text-[8.5rem] leading-none text-outline-num opacity-45 transition-opacity duration-500 group-hover:opacity-80 sm:text-[9.5rem]">
              {plan.duration.match(/\d+/)?.[0].padStart(2, '0')}
            </span>
            {plan.highlight && <img src="/brand/phoenix-emblem.png" alt="" width="171" height="218" class="absolute -right-6 -bottom-8 h-48 w-auto opacity-[0.06]" />}
          </div>
          {plan.highlight && <span class="plan-ring" aria-hidden="true" />}

          {plan.highlight && plan.highlightLabel && (
            <span class="badge-gold absolute -top-3.5 left-1/2 z-10 -translate-x-1/2">
              <span class="sheen" aria-hidden="true" />
              <span class="relative">{plan.highlightLabel}</span>
            </span>
          )}

          <div class="relative">
            <p class="eyebrow whitespace-nowrap text-brand-400">{plan.duration}</p>
            <h3 class="mt-2 font-display text-5xl leading-none uppercase">{plan.name}</h3>
          </div>

          <div class="relative my-8">
            <span class="block h-px bg-gradient-to-r from-brand-500/60 via-brand-500/20 to-transparent" aria-hidden="true"></span>
            <div class="py-6">
              {plan.price !== null ? (
                <p class="flex items-baseline gap-2">
                  <span class="font-display text-6xl leading-none tracking-[-0.01em] text-brand-gradient tabular-nums">{formatINR(plan.price)}</span>
                  {plan.priceNote && <span class="eyebrow text-ash-400">{plan.priceNote}</span>}
                </p>
              ) : (
                <>
                  <p class="font-display text-4xl leading-none text-brand-gradient uppercase">Price on enquiry</p>
                  <p class="mt-2 text-sm text-ash-400">Message us for current rates.</p>
                </>
              )}
            </div>
            <span class="block h-px bg-gradient-to-r from-brand-500/60 via-brand-500/20 to-transparent" aria-hidden="true"></span>
          </div>

          <ul class="relative flex-1 space-y-3.5">
            {plan.benefits.map((b, j) => (
              <li class="reveal flex gap-3 text-sm" style={`--reveal-y:10px; --d:${(0.25 + i * 0.06 + j * 0.1).toFixed(2)}s`}>
                <span class="icon-well mt-0.5 size-5 rounded-full">
                  <Check className="size-3" weight="bold" />
                </span>
                <span class={plan.highlight ? 'font-medium text-bone' : 'text-ash-300'}>{b}</span>
              </li>
            ))}
          </ul>

          {!plan.verified && <PlaceholderBadge label="Inclusions TBC" className="relative mt-6 self-start" />}

          <!-- Handled by scripts/site.ts: pre-fills the enquiry form and scrolls to it -->
          <Button data-enquire={`${plan.name} membership`} variant={plan.highlight ? 'primary' : 'outline'} className="relative mt-8 w-full">
            Enquire now
          </Button>
        </article>
      ))}
    </div>
    <div data-carousel-dots="plans-track" class="mt-5 flex justify-center gap-2 md:hidden" aria-label="Choose a plan"></div>

    {anyUnverified && (
      <div class="reveal mt-10 flex items-start gap-3 text-sm text-ash-400 sm:items-center sm:justify-center">
        <Info className="mt-0.5 size-4 shrink-0 text-brand-400 sm:mt-0" weight="duotone" />
        <p>{membershipNote}</p>
      </div>
    )}
  </div>
</section>
