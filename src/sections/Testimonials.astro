---
/**
 * Sample testimonials are visible ONLY in development (clearly badged).
 * Production renders only real ones (`isSample: false`); with none yet, it
 * shows a founding-member invitation, so no fictional reviews reach visitors.
 */
import { CalendarCheck, CaretLeft, CaretRight } from '@phosphor-icons/react'
import { SHOW_PLACEHOLDER_BADGES, site } from '../config/site'
import { testimonials } from '../data/content'
import ButtonLink from '../components/ButtonLink.astro'
import SectionHeader from '../components/SectionHeader.astro'
import { PlaceholderBadge } from '../components/ui/PlaceholderBadge'

const visible = testimonials.filter((t) => !t.isSample || SHOW_PLACEHOLDER_BADGES)
/** Split a quote around its highlighted phrase (if any) so that phrase can be set in gold. */
const parts = (quote: string, hl?: string) => {
  const at = hl ? quote.indexOf(hl) : -1
  return at < 0 ? { before: quote, hl: '', after: '' } : { before: quote.slice(0, at), hl: hl!, after: quote.slice(at + hl!.length) }
}
---

<section id="testimonials" aria-labelledby="testimonials-title" class="section-y relative overflow-hidden bg-ash-900">
  <div class="gold-rule absolute inset-x-0 top-0" aria-hidden="true" />
  <div class="glow-orb top-1/2 left-1/2 h-[32rem] w-[70rem] -translate-x-1/2 -translate-y-1/2" aria-hidden="true" />
  <div class="container-x relative">
    <SectionHeader
      id="testimonials-title"
      index="07"
      eyebrow="Member stories"
      lines={visible.length ? ['Heard on', 'the floor.'] : ['Your story', { text: 'starts here.', class: 'text-brand-gradient' }]}
      intro={
        visible.length
          ? 'Real words from our members and early sign-ups.'
          : `We're just getting started in ${site.location.city}. Join as one of our first members and your transformation could be the first story told here.`
      }
    />

    <!-- One review: a single, wider centred card. Two or more: a swipeable row (1 card on phones, ~1.5 on tablets,
         3 on desktop) with gold dots + arrows, so the section stays compact however many reviews come in. -->
    {visible.length > 0 ? (
      <>
      <div class="relative mt-14 sm:mt-20">
      {visible.length > 1 && (
        <>
          <button type="button" data-carousel-prev="reviews-track" aria-label="Previous review" class="carousel-arrow -left-2 sm:-left-3 lg:-left-6">
            <CaretLeft className="size-4" weight="bold" />
          </button>
          <button type="button" data-carousel-next="reviews-track" aria-label="Next review" class="carousel-arrow -right-2 sm:-right-3 lg:-right-6">
            <CaretRight className="size-4" weight="bold" />
          </button>
        </>
      )}
      <div
        id="reviews-track"
        data-carousel={visible.length > 1 ? '' : undefined}
        class:list={[
          visible.length === 1
            ? 'mx-auto grid max-w-2xl'
            : 'no-scrollbar flex snap-x snap-mandatory gap-4 overflow-x-auto pt-1 pb-3 [&>article]:w-[88%] [&>article]:shrink-0 [&>article]:snap-start sm:[&>article]:w-[62%] lg:[&>article]:w-[calc((100%-2rem)/3)]',
        ]}
      >
        {visible.map((t, i) => (
          <article class="reveal card-lux review-card group flex flex-col rounded-[1.75rem] p-7 sm:p-10" style={`--d:${i * 0.1}s`}>
            <!-- decor: gold aura, slowly circling gold border, giant outline quote mark -->
            <div class="pointer-events-none absolute inset-0 overflow-hidden rounded-[inherit]" aria-hidden="true">
              <span class="plan-aura absolute inset-0"></span>
              <span class="absolute top-2 right-6 font-serif text-[9rem] leading-[0.8] text-outline-num opacity-35 transition-opacity duration-500 group-hover:opacity-70 sm:text-[11rem]">“</span>
            </div>
            {!t.isSample && <span class="plan-ring opacity-70" aria-hidden="true" />}

            <div class="relative flex items-center justify-between gap-3">
              <span class="inline-flex items-center gap-1.5 rounded-full border border-brand-500/35 bg-brand-500/10 px-3 py-1 font-mono text-[0.62rem] font-semibold tracking-[0.16em] text-brand-300 uppercase">
                <CalendarCheck className="size-3.5" weight="fill" />
                {t.detail}
              </span>
              {t.isSample && <PlaceholderBadge label="Sample — not real" />}
            </div>

            <blockquote class:list={["relative mt-7 flex-1 text-lg leading-relaxed text-bone/90 sm:text-xl sm:leading-relaxed", visible.length > 1 && "lg:text-lg"]}>
              {(() => { const q = parts(t.quote, t.highlight); return <>“{q.before}{q.hl && <span class="text-brand-gradient font-semibold">{q.hl}</span>}{q.after}”</> })()}
            </blockquote>

            <footer class="relative mt-8 flex items-center gap-4 border-t border-bone/10 pt-6">
              {t.photo ? (
                <span class="review-avatar" aria-hidden="true">
                  <img src={t.photo} alt="" width="160" height="160" loading="lazy" decoding="async" class="size-full rounded-full object-cover" />
                </span>
              ) : (
                <span class="grid size-12 place-items-center rounded-full bg-ash-700 font-display text-xl text-brand-300">{t.name.charAt(0)}</span>
              )}
              <span>
                <span class="block text-lg font-semibold text-bone">{t.name}</span>
                <span class="block text-sm text-ash-400">Phoenix Gym, {site.location.city}</span>
              </span>
            </footer>
          </article>
        ))}
      </div>
      </div>
      {visible.length > 1 && <div data-carousel-dots="reviews-track" class="mt-7 flex justify-center gap-2" aria-label="Choose a review"></div>}
      </>
    ) : (
      <div class="reveal mt-12">
        <ButtonLink href="#membership" size="lg">
          Become a founding member
        </ButtonLink>
      </div>
    )}
  </div>
</section>
